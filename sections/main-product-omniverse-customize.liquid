{%- assign meta_block = section.blocks | where: 'type', 'product_meta' | first -%}
{%- assign share_buttons_block = section.blocks | where: 'type', 'share_buttons' | first -%}
{%- assign inventory_block = section.blocks | where: 'type', 'inventory' | first -%}
{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

{% assign app_blocks = section.blocks | where: 'type', '@app' %}
{% assign review_star_app_block = app_blocks[0] %}

{% capture fit_guide_block %}
  {% assign  collections = product.collections  %}

  {% for collection in collections %}
    {% if collection.metafields.custom.fit_guide %} 
      {% assign fit_guide = collection.metafields.custom.fit_guide %}
    {% endif %}
    {% break %}
  {% endfor %}

  {% if fit_guide.value == "belts" %}
    {% render 'fit-guide-belts-modal' %}
  {% endif %}
{% endcapture %}

  {% if template.name == 'product' %}
  {{ 'product-customize.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-customize.js' | asset_url }}" defer></script>
{% endif %}

{%- capture section_settings -%}
{
  "enableHistoryState": true,
  "templateSuffix": {{ product.template_suffix | json }},
  "showInventoryQuantity": {% if inventory_block != blank %}true{% else %}false{% endif %},
  "showSku": {{ meta_block.settings.show_sku | json }},
  "stackProductImages": {{ section.settings.stack_images | json }},
  "showThumbnails": {{ section.settings.show_thumbnails | json }},
  "enableVideoLooping": {{ section.settings.enable_video_looping | json }},
  "inventoryQuantityThreshold": {{ inventory_block.settings.inventory_quantity_threshold | default: 0 }},
  "showPriceInButton": {{ buy_buttons_block.settings.show_price_in_button | json }},
  "enableImageZoom": {{ section.settings.enable_image_zoom | json }},
  "showPaymentButton": {{ buy_buttons_block.settings.show_payment_button | json }},
  "useAjaxCart": {% if settings.cart_type == 'drawer' %}true{% else %}false{% endif %}
}
{%- endcapture -%}
<script>
  // To power the recently viewed products section, we save the ID of the product inside the local storage
  (() => {
    let items = JSON.parse(localStorage.getItem('recentlyViewedProducts') || '[]');
  
    // We check if the current product already exists, and if it does not, we add it at the start
    if (!items.includes({{ product.id }})) {[]
      items.unshift({{ product.id }});
    }
  
    // Then, we save the current product into the local storage, by keeping only the 8 most recent
    try {
      localStorage.setItem('recentlyViewedProducts', JSON.stringify(items.slice(0, 8)));
    } catch (error) {
      // Do nothing, this may happen in Safari in incognito mode
    }
  })();
</script>

{% capture product_title_price %}
  <div id="product-title" 
  style="font-size: {{ section.settings.product_title_font_size }};
  font-weight: {{ section.settings.product_title_font_weight }};
  color: {{ section.settings.product_title_color }};
  padding: {{ section.settings.product_title_padding }} 0px;">
    {{product.title}}
    </div>
  {% if product.metafields.custom.heading  %}
    <div id="product-description"
    style="font-size:{{ section.settings.product_description_font_size }};
    font-weight: {{ section.settings.product_description_font_weight }};
    color: {{ section.settings.product_description_color }};
    padding: {{ section.settings.product_description_padding }} 0px;"
    >
      {{ product.metafields.custom.heading }}
      </div>
  {% endif %}
  <div class="review-star" style="padding:{{ section.settings.star_review_padding }} 0px">
    {% render review_star_app_block %}
    <div id="review-star-cover"></div>
  </div>

  <div id="product-price" style="padding: {{ section.settings.product_price_padding }} 0px;">
    <span id="max-price"
      style="text-decoration: line-through; 
      {% if product.selected_or_first_available_variant.compare_at_price <= product.selected_or_first_available_variant.price %}display: none;{% endif %}
      color: {{ section.settings.product_compare_at_price_color }};
      font-size: {{ section.settings.product_compare_at_price_font_size }};
      font-weight: {{ section.settings.product_price_font_weight }};
      "
    >{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
    <span id="current-price" class="current-price"
    style="color:{{ section.settings.product_price_color }};
    font-size: {{ section.settings.product_price_font_size }};
    font-weight: {{ section.settings.product_compare_price_font_weight }};
    "
    >
      {{ product.selected_or_first_available_variant.price | money }}
    </span>
  </div>
{% endcapture %}

<section
  class="Product-omniverse"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-section-settings='{{ section_settings }}'
  style="z-index: 5;">

  <div
    hook-widget-count="{{ product.id }}"
    class="sold-count-widget"
    data-counter="{{ product.metafields['app--71373979649--soldcount'].counter }}"
    data-resent="{{ product.metafields['app--71373979649--soldcount'].customer }}"></div>
  <div class="product-info-mobile">{{ product_title_price }}</div>

  <div class="product-gallery-info-container">

    {% comment %} VARIANT GALLERY {% endcomment %}
    {% assign gallery = product.images %}
    {% assign selected_variant = product.selected_or_first_available_variant %}
    {% if selected_variant.metafields.custom.variant_gallery %}
      {% assign gallery = selected_variant.metafields.custom.variant_gallery.value %}
    {% endif %}
    {% assign selected_color = selected_variant.option1 %}
    <div class="product-gallery-container">

      <div class="side-product-media-container">
        {% for image in gallery %}
          {% assign image_src = image | image_url: width: 128, height: 128, crop: 'center' %}
          {% assign alt_text = image.alt | default: product.title %}
          {% assign variant_ids = image.variants | map: 'id' | join: ',' %}

          <div
            class="product-media"
            data-url="{{ image_src }}"
            data-index="{{ forloop.index0 }}"
            data-media-id="{{ image.id }}"
            data-variant-id="{{ variant_ids }}">
            <img
              src="{{ image_src }}"
              loading="eager"
              alt="{{ alt_text | escape }}"
              width="128"
              height="128">
          </div>
        {% endfor %}
      </div>
      <div id="product-media-container-for-scroll">
        {% comment %} Sold out Badge {% endcomment %}
        <div id="sold-out-badge_wrapper">
          <span class="sold-out-badge">Sold Out</span>
        </div>

        <div class="product-media-container">
          {% for image in gallery %}
            <div class="product-media-wrapper">
              {{ image
 | image_url: width: 900, height: 900, crop: 'center'
 | image_tag:
 loading: 'eager',
 alt: image,
 class: 'product-media',
 data-url: image,
 data_index: forloop.index0,
 data_media_id: image.id
              }}
            </div>
          {% endfor %}
        </div>

        <div class="dots-container">
          <div id="all-dots">
            {% for image in gallery limit: 10 %}
              <div class="dot" data-index="{{ forloop.index0 }}"></div>
            {% endfor %}
          </div>
        </div>

        <div class="arrow__container">
          <div class="arrow__inner-container">
            <div class="arrow gallery-left-arrow">{% render 'icon' with 'arrow-left' %}</div>
            <div class="arrow gallery-right-arrow">{% render 'icon' with 'arrow-right' %}</div>
          </div>
        </div>

      </div>
  </div>
    {% comment %} PRODUCT INFO {% endcomment %}
    {% render 'product-info'
      , product_title_price: product_title_price
      , fit_guide_block: fit_guide_block %}

  </div>

  {% comment %} FLOAT CART FOR MOBILE  {% endcomment %}
  <div id="mobile-floating-cart">
    {% assign media = selected_variant.featured_media %}
    {% if selected_variant.featured_media == blank %}
      {% assign media = selected_variant.product.featured_media %}
    {% endif %}
    <img
      height="128"
      width="128"
      src="{{ media | image_url: width: 128, height: 128, crop: 'center' }}"
      alt="variant image"
      id="mobile-variant-image">
    <span id="cart-title">{{ selected_variant.product.title }}</span>
    <div id="float-cart-button-container">
      <div id="float-cart__overlay-button"></div>
      <button
        disabled
        type="submit"
        data-action="add-to-cart"
        class="ProductForm__AddToCart">
        Add to Cart
      </button>
    </div>
  </div>


  {%- capture product_aside -%}
      {%- render 'product-tabs' -%}
      {%- assign complementary_products_block = section.blocks | where: 'type', 'complementary_products' | first -%}
    {%- endcapture -%}


  <script id="ProductJson-{{ product.id }}" type="application/json">
    {{ product | json }}
  </script>

  {%- if product_aside != blank -%}
    <div class="Product__Aside">
      <span id="ProductAside" class="Anchor"></span>
      {{- product_aside -}}
    </div>
  {%- endif -%}
  <div class="mobile_product_tabs">
    {% include 'dynamic-tabs' %}
  </div>
</section>

{%- if section.settings.enable_image_zoom -%}
  <div
    class="pswp"
    tabindex="-1"
    role="dialog"
    aria-hidden="true">
    <!-- Background of PhotoSwipe -->
    <div class="pswp__bg"></div>

    <!-- Slides wrapper with overflow:hidden. -->
    <div class="pswp__scroll-wrap">

      <!-- Container that holds slides. Do not remove as content is dynamically added -->
      <div class="pswp__container">
        <div class="pswp__item"></div>
        <div class="pswp__item"></div>
        <div class="pswp__item"></div>
      </div>

    <!-- Main UI bar - MUST KEEP -->

    </div>
  </div>
{%- endif -%}

<script>
  window.ShopifyXR=window.ShopifyXR||function(){(ShopifyXR.q=ShopifyXR.q||[]).push(arguments)};
  ShopifyXR('addModels', {{ product.media | where: 'media_type', 'model' | json }});
  
  window.ShopifyConfig = {
    moneyFormat: {{ shop.money_format | json }},
    moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
    currency: {{ shop.currency | json }}
  };
</script>
